# Copie para .env (local) ou cadastre em Vercel > Project > Settings > Environment Variables

# true = demonstração (contas de teste visíveis na tela de entrada). false = operação real.
DEMO_MODE=true

# Obrigatório com DEMO_MODE=false. Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Administrador inicial quando DEMO_MODE=false (senha com 12+ caracteres)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Banco persistente (recomendado na Vercel). Sem isso, a Vercel usa SQLite temporário em /tmp.
# Ex.: postgresql://usuario:senha@host/banco?sslmode=require  (Neon, Supabase)
DATABASE_URL=

TOKEN_EXPIRE_HOURS=10
